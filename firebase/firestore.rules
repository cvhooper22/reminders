rules_version = '2';

// Only the Cloud Functions (via the Admin SDK, which bypasses these rules) ever
// touch Firestore. No client -- web, mobile, or otherwise -- talks to it directly,
// so everything is denied here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
