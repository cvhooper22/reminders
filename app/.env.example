# Copy to .env.local. Leave EXPO_PUBLIC_API_BASE unset to run against in-memory mock data (no login).
# Local emulator (run `npm run backend` then `npm run seed` from the repo root):
EXPO_PUBLIC_API_BASE=http://127.0.0.1:5002/demo-reminders/us-west3
# Optional dev shortcut that skips the login screen. Only honored by the dev server (`npm run web`);
# production exports (`npm run build:web`) never include it. Leave unset to test the login screen.
EXPO_PUBLIC_API_KEY=dev-local-key
